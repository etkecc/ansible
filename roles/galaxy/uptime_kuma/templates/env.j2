TZ={{ uptime_kuma_environment_variables_tz }}

{% if uptime_kuma_database_type == 'mariadb' %}
UPTIME_KUMA_DB_TYPE=mariadb

{% if uptime_kuma_database_socket_enabled %}
UPTIME_KUMA_DB_SOCKET={{ uptime_kuma_environment_variables_uptime_kuma_db_socket }}
{% else %}
UPTIME_KUMA_DB_HOSTNAME={{ uptime_kuma_database_hostname }}
UPTIME_KUMA_DB_PORT={{ uptime_kuma_database_port }}
{% endif %}

UPTIME_KUMA_DB_USERNAME={{ uptime_kuma_database_username }}
UPTIME_KUMA_DB_PASSWORD={{ uptime_kuma_database_password }}
UPTIME_KUMA_DB_NAME={{ uptime_kuma_database_name }}
UPTIME_KUMA_DB_SSL={{ uptime_kuma_database_ssl | to_json }}
UPTIME_KUMA_DB_CA={{ uptime_kuma_database_ca }}
{% endif %}

{{ uptime_kuma_environment_variables_additional_variables }}
