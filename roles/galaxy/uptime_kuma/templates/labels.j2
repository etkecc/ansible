{% if uptime_kuma_container_labels_traefik_enabled %}
traefik.enable=true

{% if uptime_kuma_container_labels_traefik_docker_network %}
traefik.docker.network={{ uptime_kuma_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if uptime_kuma_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ uptime_kuma_identifier }}-slashless-redirect.redirectregex.regex=^({{ uptime_kuma_container_labels_traefik_path_prefix | quote }})$
traefik.http.middlewares.{{ uptime_kuma_identifier }}-slashless-redirect.redirectregex.replacement=${1}/
{% set middlewares = middlewares + [uptime_kuma_identifier + '-slashless-redirect'] %}
{% endif %}

{% if uptime_kuma_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ uptime_kuma_identifier }}-strip-prefix.stripprefix.prefixes={{ uptime_kuma_container_labels_traefik_path_prefix }}
{% set middlewares = middlewares + [uptime_kuma_identifier + '-strip-prefix'] %}
{% endif %}

{% if uptime_kuma_container_labels_traefik_additional_request_headers.keys() | length > 0 %}
{% for name, value in uptime_kuma_container_labels_traefik_additional_request_headers.items() %}
traefik.http.middlewares.{{ uptime_kuma_identifier }}-add-request-headers.headers.customrequestheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [uptime_kuma_identifier + '-add-request-headers'] %}
{% endif %}

{% if uptime_kuma_container_labels_traefik_additional_response_headers.keys() | length > 0 %}
{% for name, value in uptime_kuma_container_labels_traefik_additional_response_headers.items() %}
traefik.http.middlewares.{{ uptime_kuma_identifier }}-add-response-headers.headers.customresponseheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [uptime_kuma_identifier + '-add-response-headers'] %}
{% endif %}

traefik.http.routers.{{ uptime_kuma_identifier }}.rule={{ uptime_kuma_container_labels_traefik_rule }}
{% if uptime_kuma_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ uptime_kuma_identifier }}.priority={{ uptime_kuma_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ uptime_kuma_identifier }}.service={{ uptime_kuma_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ uptime_kuma_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ uptime_kuma_identifier }}.entrypoints={{ uptime_kuma_container_labels_traefik_entrypoints }}
traefik.http.routers.{{ uptime_kuma_identifier }}.tls={{ uptime_kuma_container_labels_traefik_tls | to_json }}
{% if uptime_kuma_container_labels_traefik_tls %}
traefik.http.routers.{{ uptime_kuma_identifier }}.tls.certResolver={{ uptime_kuma_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ uptime_kuma_identifier }}.loadbalancer.server.port={{ uptime_kuma_container_http_port }}

{% if uptime_kuma_container_labels_traefik_metrics_enabled %}
########################################################################
#                                                                      #
# Metrics                                                              #
#                                                                      #
########################################################################

{% set middlewares = uptime_kuma_container_labels_traefik_metrics_middlewares %}

{% if uptime_kuma_container_labels_traefik_metrics_middleware_basic_auth_enabled %}
traefik.http.middlewares.{{ uptime_kuma_identifier }}-metrics-basic-auth.basicauth.users={{ uptime_kuma_container_labels_traefik_metrics_middleware_basic_auth_users }}
{% set middlewares = middlewares + [uptime_kuma_identifier + '-metrics-basic-auth'] %}
{% endif %}

traefik.http.middlewares.{{ uptime_kuma_identifier }}-metrics-replace-path.replacepath.path=/metrics
{% set middlewares = middlewares + [uptime_kuma_identifier + '-metrics-replace-path'] %}

traefik.http.routers.{{ uptime_kuma_identifier }}-metrics.rule={{ uptime_kuma_container_labels_traefik_metrics_rule }}

{% if uptime_kuma_container_labels_traefik_metrics_priority | int > 0 %}
traefik.http.routers.{{ uptime_kuma_identifier }}-metrics.priority={{ uptime_kuma_container_labels_traefik_metrics_priority }}
{% endif %}

traefik.http.routers.{{ uptime_kuma_identifier }}-metrics.service={{ uptime_kuma_identifier }}-metrics

{% if middlewares | length > 0 %}
traefik.http.routers.{{ uptime_kuma_identifier }}-metrics.middlewares={{ middlewares | join(',') }}
{% endif %}

traefik.http.routers.{{ uptime_kuma_identifier }}-metrics.entrypoints={{ uptime_kuma_container_labels_traefik_metrics_entrypoints }}

traefik.http.routers.{{ uptime_kuma_identifier }}-metrics.tls={{ uptime_kuma_container_labels_traefik_metrics_tls | to_json }}
{% if uptime_kuma_container_labels_traefik_metrics_tls %}
traefik.http.routers.{{ uptime_kuma_identifier }}-metrics.tls.certResolver={{ uptime_kuma_container_labels_traefik_metrics_tls_certResolver }}
{% endif %}

traefik.http.services.{{ uptime_kuma_identifier }}-metrics.loadbalancer.server.port={{ uptime_kuma_container_http_port }}

########################################################################
#                                                                      #
# /Metrics                                                             #
#                                                                      #
########################################################################
{% endif %}

{% endif %}

{% for arg in uptime_kuma_container_labels_additional_labels %}
{{ arg }}
{% endfor %}
