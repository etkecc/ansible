#jinja2: lstrip_blocks: True
#!/bin/bash

# Runs psql inside the (running) Postgres container, connecting the same way the managed databases preparation does.
# The credentials come from the env-postgres-psql file, which Docker reads itself, so that they do not appear on any command line.
# A TTY is only requested when there is one, so that SQL can also be piped in (e.g. `echo 'SELECT 1' | cli`).
docker_exec_args=(-i)
if [ -t 0 ]; then
    docker_exec_args+=(-t)
fi

exec docker exec \
    "${docker_exec_args[@]}" \
    --env-file={{ postgres_base_path }}/env-postgres-psql \
    {{ postgres_identifier }} \
    psql -h {{ postgres_run_path_in_container if postgres_cli_use_unix_socket_enabled else '127.0.0.1' }} \
    "$@"
