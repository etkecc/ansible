{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mother-of-all-self-hosting/renovate-config#v1.0.0"
  ],
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "A new Postgres major becomes a new variable, never a bump of an old one; Postgres has no patch releases in its versioning",
      "matchPackageNames": ["/postgres/"],
      "matchUpdateTypes": ["major", "patch"],
      "enabled": false
    },
    {
      "description": "Postgres minor releases (17.11 -> 17.12) are upstream bugfix-only: automerge via branch push once Molecule is green",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "branch"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/defaults/main.yml$/"
      ],
      "matchStrings": [
        "(?<name>postgres_container_image_v\\d+_version):\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
