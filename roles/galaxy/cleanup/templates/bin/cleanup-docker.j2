# Removes Docker images that have been superseded by a newer image of the same
# repository for a while, and optionally stopped containers and anonymous volumes.
#
# An image is removed only when:
#
# - no container uses it, running or stopped
# - a newer image of each of its repositories has been on this host for at least the grace period
# - none of its repositories matches an exclude pattern
#
# An image which lost its last tag and its repository with it (which is what
# rebuilding a local image does) counts as superseded since it lost its tag.
#
# "Newer" is about when an image arrived on this host, not when it was built:
# `Metadata.LastTagTime`, which is the pull or build time. The overlay2 graph
# driver leaves it empty for pulled images, so the build time (`Created`) stands
# in for those, which makes the grace period shorter for pulled images there.
#
# Generated by Ansible. Options come from the config file, so that Ansible runs,
# the systemd timer and manual runs all behave the same.

import argparse
import calendar
import fnmatch
import json
import re
import subprocess
import sys
import time

DEFAULT_CONFIG_PATH = {{ (system_cleanup_config_path ~ "/docker.json") | to_json }}

SECONDS_PER_DAY = 86400

# Statuses `docker container prune` removes.
STOPPED_CONTAINER_STATUSES = ("created", "exited", "dead")

SIZE_PATTERN = re.compile(r"^([0-9.]+)\s*([kMGTP]?B)$")
SIZE_UNITS = {"B": 1, "kB": 1e3, "MB": 1e6, "GB": 1e9, "TB": 1e12, "PB": 1e15}

TIME_PATTERN = re.compile(
    r"^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)(\.\d+)?(Z|[+-]\d\d:\d\d)$"
)


class CleanupError(Exception):
    pass


def log(message):
    print(message, flush=True)


def docker(*args):
    try:
        result = subprocess.run(
            ["docker"] + list(args),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True,
        )
    except OSError as error:
        raise CleanupError("Cannot run `docker`: %s" % error)
    if result.returncode != 0:
        raise CleanupError(
            "`docker %s` failed with exit code %d: %s"
            % (" ".join(args), result.returncode, result.stderr.strip())
        )
    return result.stdout


def docker_lines(*args):
    return [line for line in docker(*args).splitlines() if line.strip() != ""]


def docker_inspect(kind, ids):
    if not ids:
        return []
    return json.loads(docker(kind, "inspect", *ids))


def parse_docker_time(value):
    """Parses an RFC 3339 timestamp as Docker prints it, keeping fractions of a second
    (images tagged in quick succession differ only in those). Returns None for an empty one."""
    match = TIME_PATTERN.match(value or "")
    if match is None:
        return None
    year, month, day, hour, minute, second = (int(part) for part in match.groups()[:6])
    if year <= 1:
        return None
    timestamp = calendar.timegm((year, month, day, hour, minute, second)) + float(match.group(7) or 0)
    zone = match.group(8)
    if zone != "Z":
        offset = int(zone[1:3]) * 3600 + int(zone[4:6]) * 60
        timestamp -= offset if zone[0] == "+" else -offset
    return timestamp


def format_time(timestamp):
    return time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(timestamp))


def format_days(seconds):
    return "%.1f days" % (seconds / SECONDS_PER_DAY)


def format_size(size):
    if size < 1000:
        return "%d B" % size
    for unit in ("kB", "MB", "GB", "TB"):
        size /= 1000.0
        if size < 1000 or unit == "TB":
            return "%.1f %s" % (size, unit)


def images_disk_usage():
    """Returns how much disk space images take up, as `docker system df` reports it, or None if unknown.

    The sizes of individual images include layers they share with other images, so adding those up
    overstates what removing them frees. Measuring the total before and after does not.
    """
    for line in docker_lines("system", "df", "--format", "json"):
        entry = json.loads(line)
        if entry.get("Type") == "Images":
            match = SIZE_PATTERN.match(entry.get("Size", ""))
            if match is not None:
                return float(match.group(1)) * SIZE_UNITS[match.group(2)]
    return None


def short_id(object_id):
    return object_id.split(":", 1)[-1][:12]


def repository_of(reference):
    """`repo:tag` and `repo@digest` -> `repo`. A port in a registry host is not a tag."""
    if "@" in reference:
        return reference.split("@", 1)[0]
    name, _, tag = reference.rpartition(":")
    if name != "" and "/" not in tag:
        return name
    return reference


def load_config(path):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError) as error:
        raise CleanupError("Cannot read the config file %s: %s" % (path, error))


def parse_prune_output(output, heading):
    """Extracts the identifiers listed under `heading` in the output of `docker ... prune`."""
    identifiers = []
    in_section = False
    for line in output.splitlines():
        line = line.strip()
        if line == heading:
            in_section = True
        elif line == "" or line.endswith(":") or line.startswith("Total reclaimed space"):
            in_section = False
        elif in_section:
            identifiers.append(line)
    return identifiers


def list_stopped_container_ids():
    ids = []
    for status in STOPPED_CONTAINER_STATUSES:
        ids += docker_lines("container", "ls", "-aq", "--no-trunc", "--filter", "status=" + status)
    return ids


def prune_containers(dry_run):
    names = {
        container["Id"]: container["Name"].lstrip("/")
        for container in docker_inspect("container", list_stopped_container_ids())
    }
    if dry_run:
        removed_ids = list(names)
    else:
        removed_ids = parse_prune_output(docker("container", "prune", "-f"), "Deleted Containers:")

    verb = "Would remove" if dry_run else "Removed"
    for container_id in removed_ids:
        log("%s stopped container %s (%s)" % (verb, names.get(container_id, "?"), short_id(container_id)))
    return len(removed_ids)


def prune_volumes(dry_run):
    # `docker volume prune` without `--all` only removes anonymous volumes.
    if dry_run:
        removed = docker_lines(
            "volume", "ls", "-q",
            "--filter", "dangling=true",
            "--filter", "label=com.docker.volume.anonymous",
        )
    else:
        removed = parse_prune_output(docker("volume", "prune", "-f"), "Deleted Volumes:")

    verb = "Would remove" if dry_run else "Removed"
    for volume in removed:
        log("%s anonymous volume %s" % (verb, volume))
    return len(removed)


class Image:
    def __init__(self, data):
        self.id = data["Id"]
        self.tags = data.get("RepoTags") or []
        self.size = data.get("Size") or 0
        references = self.tags + (data.get("RepoDigests") or [])
        self.repositories = sorted(set(repository_of(reference) for reference in references))
        self.created = parse_docker_time(data.get("Created")) or 0
        last_tag_time = parse_docker_time((data.get("Metadata") or {}).get("LastTagTime"))
        self.arrived = last_tag_time if last_tag_time is not None else self.created

    @property
    def name(self):
        if self.tags:
            return ", ".join(self.tags)
        if self.repositories:
            return "%s (untagged, %s)" % (", ".join(self.repositories), short_id(self.id))
        return "untagged image " + short_id(self.id)

    @property
    def order(self):
        return (self.arrived, self.created, self.id)


def superseded_since(image, images_by_repository):
    """Returns since when `image` has been superseded, or None if it has not been."""
    if not image.repositories:
        return image.arrived

    since = None
    for repository in image.repositories:
        newer = [other.arrived for other in images_by_repository[repository] if other.order > image.order]
        if not newer:
            return None
        since = max(since or 0, min(newer))
    return since


def excluded_by(image, patterns):
    for repository in image.repositories:
        for pattern in patterns:
            if fnmatch.fnmatchcase(repository, pattern):
                return pattern
    return None


def remove_image(image):
    """Removes an image without forcing it, so that Docker refuses if a container started using it meanwhile."""
    try:
        docker("image", "rm", *(image.tags or [image.id]))
        if image.tags:
            # Removing the tags may leave the image behind under a digest reference.
            try:
                docker("image", "inspect", image.id)
            except CleanupError:
                return None
            docker("image", "rm", image.id)
    except CleanupError as error:
        return str(error)
    return None


def prune_images(config, dry_run):
    grace_period = config["superseded_images_grace_period_days"] * SECONDS_PER_DAY
    patterns = config["superseded_images_exclude_patterns"]
    now = time.time()

    container_ids = docker_lines("container", "ls", "-aq", "--no-trunc")
    if dry_run and config["remove_stopped_containers"]:
        # Those would have been pruned by now.
        stopped = set(list_stopped_container_ids())
        container_ids = [container_id for container_id in container_ids if container_id not in stopped]
    used_ids = set(container["Image"] for container in docker_inspect("container", container_ids))

    # `docker image ls` without `--all` leaves out the intermediate images of the
    # classic builder, which cannot be removed while their children exist. On the
    # containerd image store it also leaves out dangling images, so those are
    # listed separately.
    image_ids = docker_lines("image", "ls", "-q", "--no-trunc")
    image_ids += docker_lines("image", "ls", "-q", "--no-trunc", "--filter", "dangling=true")
    images = [Image(data) for data in docker_inspect("image", list(dict.fromkeys(image_ids)))]

    images_by_repository = {}
    for image in images:
        for repository in image.repositories:
            images_by_repository.setdefault(repository, []).append(image)

    disk_usage_before = None if dry_run else images_disk_usage()
    removed_count = 0
    for image in sorted(images, key=lambda image: image.name):
        if image.id in used_ids:
            continue
        since = superseded_since(image, images_by_repository)
        if since is None:
            continue

        superseded_for = now - since
        reason = "%s since %s (%s ago)" % (
            "superseded by a newer image" if image.repositories else "untagged",
            format_time(since),
            format_days(superseded_for),
        )

        pattern = excluded_by(image, patterns)
        if pattern is not None:
            log("Keeping %s: %s, but excluded by the pattern %s" % (image.name, reason, pattern))
            continue

        if superseded_for < grace_period:
            log("Keeping %s for another %s: %s" % (image.name, format_days(grace_period - superseded_for), reason))
            continue

        if dry_run:
            log("Would remove image %s (%s): %s" % (image.name, format_size(image.size), reason))
        else:
            error = remove_image(image)
            if error is not None:
                log("Failed to remove image %s: %s" % (image.name, error))
                continue
            log("Removed image %s (%s): %s" % (image.name, format_size(image.size), reason))
        removed_count += 1

    freed = None
    if removed_count > 0 and disk_usage_before is not None:
        disk_usage_after = images_disk_usage()
        if disk_usage_after is not None:
            freed = max(0, disk_usage_before - disk_usage_after)
    return removed_count, freed


def main():
    parser = argparse.ArgumentParser(description="Removes superseded Docker images and other Docker leftovers.")
    parser.add_argument("--config", default=DEFAULT_CONFIG_PATH, help="config file (default: %(default)s)")
    parser.add_argument("--dry-run", action="store_true", help="report what would be removed, without removing anything")
    args = parser.parse_args()

    try:
        config = load_config(args.config)
        dry_run = args.dry_run or config["dry_run"]
        if dry_run:
            log("Dry run: nothing will be removed")

        containers = images = volumes = 0
        freed = None
        if config["remove_stopped_containers"]:
            containers = prune_containers(dry_run)
        if config["remove_superseded_images"]:
            images, freed = prune_images(config, dry_run)
        if config["remove_anonymous_volumes"]:
            volumes = prune_volumes(dry_run)
    except CleanupError as error:
        print("Error: %s" % error, file=sys.stderr, flush=True)
        return 1

    log(
        "Summary: %s %d stopped container(s), %d image(s)%s and %d anonymous volume(s)"
        % (
            "would remove" if dry_run else "removed",
            containers,
            images,
            " (freeing %s of image storage)" % format_size(freed) if freed is not None else "",
            volumes,
        )
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
